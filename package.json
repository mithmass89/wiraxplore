{
  "name": "wiraxplore",
  "version": "0.2.0",
  "description": "E2E testing harness for Lightpanda, Playwright and Puppeteer. Integrates with coding agents (OpenCode, Command Code) via MCP and plugins.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wiraxplore": "./bin/wiraxplore.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run tests/unit",
    "test:engine": "vitest run tests/e2e",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "mcp": "tsx src/mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chalk": "^5.6.2",
    "commander": "^15.1.0",
    "fs-extra": "^11.3.4",
    "ora": "^9.3.0",
    "playwright-core": "^1.65.0",
    "puppeteer-core": "^25.17.0",
    "ws": "^8.20.0",
    "yaml": "^2.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "lightpanda",
    "playwright",
    "puppeteer",
    "e2e",
    "testing",
    "browser",
    "mcp",
    "opencode",
    "commandcode",
    "flutter"
  ],
  "license": "MIT"
}
